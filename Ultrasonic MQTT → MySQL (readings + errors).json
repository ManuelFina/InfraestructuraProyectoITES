    {
      "parameters": {
        "jsCode": "// Compatible con las versiones nuevas de n8n\nconst item = $input.first();\nconst inJson = item.json || {};\n\nconst raw = inJson.payload ?? inJson.message ?? inJson;\n\nlet obj;\ntry {\n  obj = (typeof raw === 'string') ? JSON.parse(raw) : raw;\n} catch (e) {\n  // Si hay error al parsear JSON, devolvemos un objeto marcando el error\n  return {\n    json: {\n      __parse_error: String(e),\n      __raw: raw,\n      __topic: inJson.topic ?? null\n    }\n  };\n}\n\n// Devolvemos un solo objeto (no array)\nreturn {\n  json: {\n    device_id: obj.deviceId ?? obj.device_id ?? 'unknown',\n    distance_cm: Number(obj.distance_cm),\n    angle_deg: Number(obj.angle_deg),\n    raw_us: Number(obj.raw_us),\n    correlation_id: obj.correlationId ?? obj.correlation_id ?? null,\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        176
      ],
      "id": "1036a2cd-db95-44e2-a58c-fcea3e5441a5",
      "name": "Code — Normalize"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst j = item.json || {};\n\nlet reason = '';\n\nif (j.__parse_error) {\n  reason = `JSON parse error: ${j.__parse_error}`;\n} else {\n  const parts = [];\n  if (!(j.device_id && String(j.device_id).length)) parts.push('device_id missing');\n  if (!(Number.isFinite(j.distance_cm) && j.distance_cm > 0)) parts.push('distance_cm invalid');\n  if (!(Number.isFinite(j.angle_deg) && j.angle_deg >= 0)) parts.push('angle_deg invalid');\n  if (!Number.isFinite(j.raw_us)) parts.push('raw_us invalid');\n  reason = parts.join(', ') || 'unknown error';\n}\n\nreturn {\n  json: {\n    topic: j.__topic ?? null,\n    raw_payload: j.__raw ? String(j.__raw) : JSON.stringify(j),\n    error_msg: reason\n  }\n};\n"
      },
